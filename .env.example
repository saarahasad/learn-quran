# Copy to .env.local and restart `npm run dev`

# Login + cloud progress sync (Supabase)
# Create a free project at https://supabase.com, then Project Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Free option (recommended): https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here

# Iʿrāb tutor (keyboard page) and Ayah iʿrāb explainer. Claude first.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Or paid OpenAI Whisper:
# OPENAI_API_KEY=sk-your-key-here
