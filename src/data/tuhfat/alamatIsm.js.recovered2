/** Tuḥfat commentary — علامات الاسم (pp. 37–42) */

function b(ar, en, label = null, footnote = null) {
  return { label, ar, en, footnote };
}

export const ALAMAT_ISM_AFTER = {
  2: [
    b("[عَلَامَاتُ الِاسْمِ]", "[The Signs of the Noun]"),

